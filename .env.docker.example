# Docker Production Environment configuration
APP_ENV=production
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_USER=delphi
POSTGRES_PASSWORD=replace_this_with_a_secure_password
POSTGRES_DB=delphidb

# The DATABASE_URL is constructed in docker-compose.yml, but if overriding:
# DATABASE_URL=postgresql://delphi:replace_this_with_a_secure_password@db:5432/delphidb

# Model Paths (Mounted inside container)
MODEL_REGISTRY_PATH=/app/models/registry.json
TOKENIZER_PATH=/app/models/tokenizer
EVENTEMBED_CHECKPOINT=/app/models/eventembed/weights.pt
EVENTNET_CHECKPOINT=/app/models/eventnet/weights.pt
CREDNET_CHECKPOINT=/app/models/crednet/weights.pt
CAUSALSEQ_CHECKPOINT=/app/models/causalseq/weights.pt
RETRIEVAL_INDEX_PATH=/app/indexes/retrieval.idx
RETRIEVAL_METADATA_PATH=/app/indexes/metadata.json
CALIBRATION_PATH=/app/models/calibration/isotonic.pkl

# Execution Mode
STRICT_TEMPORAL_MODE=true
# Set to 'production' for real execution, 'synthetic' for mocked execution
DELPHI_EXECUTION_MODE=synthetic

# Security
CORS_ORIGINS=http://localhost:8080,http://localhost
MAX_PAYLOAD_LENGTH=100000
