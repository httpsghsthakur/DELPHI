# Local Development Environment configuration
APP_ENV=development
LOG_LEVEL=DEBUG
DATABASE_URL=sqlite:///./delphi.db

# Model Paths (Local config)
MODEL_REGISTRY_PATH=models/registry.json
TOKENIZER_PATH=models/tokenizer
EVENTEMBED_CHECKPOINT=models/eventembed/weights.pt
EVENTNET_CHECKPOINT=models/eventnet/weights.pt
CREDNET_CHECKPOINT=models/crednet/weights.pt
CAUSALSEQ_CHECKPOINT=models/causalseq/weights.pt
RETRIEVAL_INDEX_PATH=indexes/retrieval.idx
RETRIEVAL_METADATA_PATH=indexes/metadata.json
CALIBRATION_PATH=models/calibration/isotonic.pkl

# Execution Mode
STRICT_TEMPORAL_MODE=false
DELPHI_EXECUTION_MODE=synthetic

# Security
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_PAYLOAD_LENGTH=500000
